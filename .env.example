# Copy to .env and fill in. .env is not committed.
# Slack app: https://api.slack.com/apps -> your app -> Basic Information -> App Credentials
LABCAT_SLACK_CLIENT_ID=
LABCAT_SLACK_CLIENT_SECRET=
# Only this workspace may sign in (the id starts with T; shown in the log after the first sign-in)
LABCAT_SLACK_TEAM_ID=
# Signs the login cookie. Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LABCAT_SECRET_KEY=
# The address people use, for the Slack redirect (must match the app's redirect URL)
LABCAT_BASE_URL=https://localhost:8420
# Person ids with access to the admin page (sync status, "Sync now"), comma-separated
LABCAT_ADMINS=matthias
# Seconds between automatic syncs with GitHub (default 600; 0 = only on save and via "Sync now")
LABCAT_PULL_INTERVAL=600
