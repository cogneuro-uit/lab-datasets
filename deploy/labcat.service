# systemd user service: keeps the catalog running at http://localhost:8420
#   cp deploy/labcat.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now labcat
[Unit]
Description=Lab dataset catalog

[Service]
WorkingDirectory=%h/Nextcloud/work/prog/lab-datasets
ExecStart=%h/.local/bin/uv run labcat serve --port 8420
Restart=on-failure

[Install]
WantedBy=default.target
